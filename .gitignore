# Build-time reference assemblies, restored from NuGet by scripts/setup-libs.ps1.
# The whole directory, not just *.dll: it is where a reference assembly would
# land if a build ever resolved one from somewhere other than NuGet, and a
# stray .pdb or .xml beside the DLLs must not become committable.
src/*/libs/

# Install state, written next to the game exe
.headtracking-state.json
